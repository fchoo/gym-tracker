    "zod": {
      "advisory": "https://github.com/advisories/GHSA-mrhx-c7xc-m3w5",
      "reason": "Only Expo SDK 57 CLI nested Zod 3.25.76 is retained. App schemas resolve patched top-level Zod 4.6.6. CLI parses developer-owned configuration; no app input reaches the nested package."
    },
    "deepmerge": {
      "advisory": "https://github.com/advisories/GHSA-gcqx-w48m-w2h4",
      "reason": "No patched upstream npm release is available. Exact 4.3.1 node is used by developer-owned Expo/Jest configuration, not application runtime inputs."
    },
    "minimatch": {
      "advisory": "https://github.com/advisories/GHSA-g3hv-75wg-m249",
      "reason": "Only four Jest/test-exclude minimatch 3.1.5 nodes remain. Reviewed advisory describes firstPhasePreProcess at optimizationLevel >=2 in 10.2.6; v3.1.5 has neither preprocessing function nor optimizationLevel. Modern tooling nodes use patched 11.0.3. Preserve Jest v3 callable API rather than replacing it with the incompatible v11 module."
    }
  },
